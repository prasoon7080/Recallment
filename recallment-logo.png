<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Recallment</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
font-family:Georgia,"Times New Roman",serif;
background:#f5f1e8;
color:#17243a;
min-height:100vh
}

header{
background:#10233f;
color:#d9b45b;
text-align:center;
padding:28px 15px;
border-bottom:4px solid #c9a24e
}

.logo{
width:125px;
height:125px;
margin:auto auto 14px;
border-radius:50%;
overflow:hidden;
border:2px solid #d9b45b;
box-shadow:0 4px 15px #0005
}

.logo img{
width:100%;
height:100%;
object-fit:cover;
display:block
}

header h1{
font-size:32px;
letter-spacing:4px;
text-transform:uppercase
}

.tagline{
margin-top:7px;
color:#f0dfad;
font-size:14px;
letter-spacing:1px
}

.container{
max-width:760px;
margin:auto;
padding:22px 16px 40px
}

.dashboard{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:10px;
margin-bottom:20px
}

.stat{
background:#fffdf8;
border:1px solid #d8c89f;
border-radius:12px;
padding:16px 5px;
text-align:center;
box-shadow:0 4px 12px #10233f14
}

.stat strong{
display:block;
font-size:27px;
color:#10233f
}

.stat span{
font-size:12px;
color:#756a52;
text-transform:uppercase;
letter-spacing:1px
}

.box{
background:#fffdf8;
border:1px solid #d8c89f;
border-radius:15px;
padding:20px;
margin-bottom:18px;
box-shadow:0 5px 18px #10233f14
}

.title{
display:flex;
gap:10px;
align-items:center;
margin-bottom:16px
}

.title b{
font-size:24px;
color:#b38a32
}

h2{font-size:22px}

input,textarea{
width:100%;
padding:14px;
margin:6px 0;
border:1px solid #d5c9aa;
border-radius:9px;
background:#fffefa;
font-family:Georgia,serif;
font-size:15px;
color:#17243a
}

textarea{
min-height:105px;
resize:vertical
}

button{
font-family:Georgia,serif;
cursor:pointer
}

.primary{
width:100%;
padding:14px;
margin-top:8px;
border:0;
border-radius:9px;
background:#10233f;
color:#e5c66f;
font-size:16px;
font-weight:bold
}

.secondary{
padding:10px 14px;
border:1px solid #c9a24e;
border-radius:8px;
background:#f8f0dc;
color:#10233f
}

.review{
border-left:5px solid #b38a32;
background:#faf7ef;
border-radius:10px;
padding:17px
}

.review h3{
font-size:20px;
margin-bottom:8px
}

.meta{
font-size:14px;
color:#766b55;
margin:5px 0
}

.answer{
display:none;
margin:13px 0;
padding:13px;
background:#f1ead7;
border:1px solid #ded1ad;
border-radius:8px;
line-height:1.6
}

.review-buttons{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:8px;
margin-top:14px
}

.review-buttons button{
padding:11px 5px;
border:1px solid #d1c39f;
border-radius:8px;
background:white;
color:#17243a
}

.review-buttons small{
display:block;
margin-top:4px;
color:#8b7954
}

.nav{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:9px
}

.nav button{
padding:13px 4px;
border:1px solid #d2c29b;
border-radius:9px;
background:#fffdf8;
color:#10233f;
font-weight:bold
}

.item{
background:#faf7ef;
border:1px solid #ddd0ae;
border-radius:10px;
padding:15px;
margin-top:10px
}

.empty{
text-align:center;
padding:25px;
color:#7b715f
}

.hidden{display:none}

.progress{
height:10px;
background:#e5ddc9;
border-radius:10px;
overflow:hidden;
margin-top:15px
}

.fill{
height:100%;
width:0;
background:#b38a32
}

footer{
text-align:center;
font-size:13px;
color:#81765f;
margin-top:20px
}

@media(max-width:500px){
header h1{font-size:27px}
.logo{width:105px;height:105px}
.stat strong{font-size:23px}
.stat span{font-size:10px}
.box{padding:17px}
}
</style>
</head>

<body>

<header>
<div class="logo">
<img src="recallment-logo.png" alt="Recallment Logo">
</div>

<h1>Recallment</h1>
<p class="tagline">Remember • Revise • Retain</p>
</header>

<div class="container">

<div class="dashboard">
<div class="stat">
<strong id="due">0</strong>
<span>Due</span>
</div>

<div class="stat">
<strong id="total">0</strong>
<span>Total</span>
</div>

<div class="stat">
<strong id="mastered">0</strong>
<span>Mastered</span>
</div>
</div>


<div id="home">

<div class="box">

<div class="title">
<b>✦</b>
<h2>Add Something</h2>
</div>

<input id="content"
placeholder="What do you want to remember?">

<textarea id="answer"
placeholder="Answer / explanation / notes"></textarea>

<input id="subject"
placeholder="Subject (optional)">

<input id="topic"
placeholder="Topic (optional)">

<button class="primary" onclick="addItem()">
Save for Revision
</button>

</div>


<div class="box">

<div class="title">
<b>↻</b>
<h2>Revision</h2>
</div>

<div id="revision"></div>

</div>


<div class="nav">
<button onclick="show('all')">All Items</button>
<button onclick="show('progress')">Progress</button>
<button onclick="show('home')">Home</button>
</div>

</div>


<div id="all" class="hidden">

<div class="box">

<div class="title">
<b>§</b>
<h2>All Items</h2>
</div>

<div id="items"></div>

</div>

<div class="nav">
<button onclick="show('home')">Home</button>
<button onclick="show('progress')">Progress</button>
</div>

</div>


<div id="progress" class="hidden">

<div class="box">

<div class="title">
<b>◆</b>
<h2>Your Progress</h2>
</div>

<div id="progressText"></div>

<div class="progress">
<div class="fill" id="fill"></div>
</div>

</div>

<div class="nav">
<button onclick="show('home')">Home</button>
<button onclick="show('all')">All Items</button>
</div>

</div>

<footer>
Recallment · Remember • Revise • Retain
</footer>

</div>


<script>

const schedule=[
10*60*1000,
60*60*1000,
12*60*60*1000,
24*60*60*1000,
7*24*60*60*1000,
30*24*60*60*1000
];

let data=JSON.parse(
localStorage.getItem("recallment_items")||"[]"
);

function save(){
localStorage.setItem(
"recallment_items",
JSON.stringify(data)
);
}

function addItem(){

let content=document.getElementById("content").value.trim();
let answer=document.getElementById("answer").value.trim();
let subject=document.getElementById("subject").value.trim();
let topic=document.getElementById("topic").value.trim();

if(!content){
alert("Please add something to remember.");
return;
}

data.push({
id:Date.now(),
content,
answer,
subject,
topic,
stage:0,
next:Date.now()+schedule[0],
reviews:0,
mastered:false
});

save();

document.getElementById("content").value="";
document.getElementById("answer").value="";
document.getElementById("subject").value="";
document.getElementById("topic").value="";

update();

alert("Saved! First revision is after 10 minutes.");
}

function dueItems(){
return data.filter(x=>!x.mastered&&x.next<=Date.now());
}

function show(page){

["home","all","progress"].forEach(x=>{
document.getElementById(x).classList.add("hidden");
});

document.getElementById(page).classList.remove("hidden");

if(page==="all")renderAll();
if(page==="progress")renderProgress();
}

function renderRevision(){

let box=document.getElementById("revision");
let due=dueItems();

if(!due.length){
box.innerHTML=
'<div class="empty">No revision due right now.</div>';
return;
}

let x=due[0];

box.innerHTML=`

<div class="review">

<h3>${safe(x.content)}</h3>

${x.subject?
`<div class="meta">Subject: ${safe(x.subject)}</div>`:""}

${x.topic?
`<div class="meta">Topic: ${safe(x.topic)}</div>`:""}

<button class="secondary"
onclick="answer(${x.id})">
Show Answer
</button>

<div class="answer" id="a${x.id}">
${safe(x.answer||"No answer added.")}
</div>

<div class="review-buttons">

<button onclick="review(${x.id},'forgot')">
❌ भूल गया
<small>10 मिनट</small>
</button>

<button onclick="review(${x.id},'hard')">
🤔 मुश्किल था
<small>Next interval</small>
</button>

<button onclick="review(${x.id},'remember')">
🙂 याद था
<small>Next interval</small>
</button>

<button onclick="review(${x.id},'easy')">
✅ बहुत अच्छे से याद था
<small>3 दिन</small>
</button>

</div>
</div>
`;
}

function answer(id){

let e=document.getElementById("a"+id);

e.style.display=e.style.display==="block"
?"none":"block";
}

function review(id,result){

let x=data.find(a=>a.id===id);
if(!x)return;

x.reviews++;

if(result==="forgot"){

x.stage=0;
x.next=Date.now()+schedule[0];
x.mastered=false;

}else if(result==="easy"){

x.next=Date.now()+3*24*60*60*1000;

x.stage=Math.min(
x.stage+1,
schedule.length-1
);

}else{

x.stage=Math.min(
x.stage+1,
schedule.length-1
);

x.next=Date.now()+schedule[x.stage];

if(x.stage===schedule.length-1)
x.mastered=true;
}

save();
update();
}

function renderAll(){

let box=document.getElementById("items");

if(!data.length){
box.innerHTML=
'<div class="empty">Nothing added yet.</div>';
return;
}

box.innerHTML=data.map(x=>`

<div class="item">

<h3>${safe(x.content)}</h3>

${x.subject?
`<div class="meta">Subject: ${safe(x.subject)}</div>`:""}

${x.topic?
`<div class="meta">Topic: ${safe(x.topic)}</div>`:""}

<div class="meta">
Reviews: ${x.reviews}
</div>

<div class="meta">
Next: ${x.mastered?
"Mastered":new Date(x.next).toLocaleString()}
</div>

</div>

`).join("");
}

function renderProgress(){

let total=data.length;

let mastered=data.filter(
x=>x.mastered
).length;

let due=dueItems().length;

let reviews=data.reduce(
(a,x)=>a+x.reviews,0
);

let percent=total?
Math.round(mastered/total*100):0;

document.getElementById("progressText").innerHTML=`

<p><b>Total items:</b> ${total}</p><br>
<p><b>Mastered:</b> ${mastered}</p><br>
<p><b>Due now:</b> ${due}</p><br>
<p><b>Total revisions:</b> ${reviews}</p><br>
<p><b>Mastery:</b> ${percent}%</p>
`;

document.getElementById("fill").style.width=
percent+"%";
}

function update(){

document.getElementById("due").textContent=
dueItems().length;

document.getElementById("total").textContent=
data.length;

document.getElementById("mastered").textContent=
data.filter(x=>x.mastered).length;

renderRevision();
}

function safe(t){

return String(t)
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");
}

update();

</script>

</body>
</html>
